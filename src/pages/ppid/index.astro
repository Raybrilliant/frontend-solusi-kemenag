---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import FormPpidPermohonan from "../../components/Svelte/FormPpidPermohonan.svelte";
import StatistikPpid from "../../components/Svelte/StatistikPpid.svelte";
import RiwayatPpid from "../../components/Svelte/RiwayatPpid.svelte";
import HeroPpid from "../../components/Svelte/HeroPpid.svelte";

const kategoris = [
    {
        label: "Informasi Berkala",
        desc: "Informasi yang wajib disediakan dan diumumkan secara berkala.",
        icon: `<path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>`,
        href: "/ppid/informasi-berkala",
        contoh: [
            "Profil dan struktur organisasi",
            "Program dan kegiatan",
            "Laporan keuangan",
            "Perjanjian dengan pihak ketiga",
        ],
    },
    {
        label: "Informasi Serta Merta",
        desc: "Informasi yang harus diumumkan seketika karena menyangkut kepentingan umum.",
        icon: `<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>`,
        href: "/portal",
        contoh: [
            "Informasi bencana/kedaruratan",
            "Kebijakan mendesak",
            "Informasi yang mempengaruhi hajat hidup orang banyak",
        ],
    },
    {
        label: "Informasi Setiap Saat",
        desc: "Informasi yang dapat diakses publik kapan saja sesuai permintaan.",
        icon: `<path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/>`,
        href: "/ppid/statistik",
        contoh: [
            "Daftar dokumen kebijakan",
            "Rencana kerja dan anggaran",
            "Data pegawai (non-rahasia)",
            "Prosedur pelayanan publik",
        ],
    },
    {
        label: "Informasi Dikecualikan",
        desc: "Informasi yang dikecualikan berdasarkan UU KIP dan peraturan terkait.",
        icon: `<path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>`,
        contoh: [
            "Informasi rahasia negara",
            "Data pribadi yang dilindungi",
            "Informasi yang melanggar hak kekayaan intelektual",
        ],
    },
];

const alurPermohonan = [
    {
        step: "01",
        judul: "Ajukan Permohonan",
        desc: "Isi formulir permohonan informasi secara tertulis atau datang langsung ke kantor.",
    },
    {
        step: "02",
        judul: "Registrasi & Tanda Terima",
        desc: "PPID mencatat dan memberikan tanda terima permohonan informasi.",
    },
    {
        step: "03",
        judul: "Pemrosesan (5 Hari Kerja)",
        desc: "PPID memproses permohonan dan menentukan ketersediaan informasi.",
    },
    {
        step: "04",
        judul: "Penyampaian Informasi",
        desc: "Informasi disampaikan sesuai format yang diminta pemohon.",
    },
];

const pageUrl = `${Astro.url.origin}/ppid`;
const structuredData = [
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
            {
                "@type": "ListItem",
                position: 1,
                name: "Beranda",
                item: `${Astro.url.origin}`,
            },
            { "@type": "ListItem", position: 2, name: "PPID", item: pageUrl },
        ],
    },
    {
        "@context": "https://schema.org",
        "@type": "GovernmentService",
        name: "PPID Kemenag Kota Probolinggo",
        description:
            "Layanan Pejabat Pengelola Informasi dan Dokumentasi untuk keterbukaan informasi publik di Kemenag Kota Probolinggo.",
        url: pageUrl,
        provider: {
            "@type": "GovernmentOrganization",
            name: "Kantor Kementerian Agama Kota Probolinggo",
            url: Astro.url.origin,
        },
        areaServed: "Kota Probolinggo",
        serviceType: "Pelayanan informasi publik",
        address: {
            "@type": "PostalAddress",
            streetAddress: "Jl. Mastrip No 323, Kanigaran",
            addressLocality: "Kota Probolinggo",
            addressRegion: "Jawa Timur",
            postalCode: "67213",
            addressCountry: "ID",
        },
        contactPoint: {
            "@type": "ContactPoint",
            telephone: "+6287838100425",
            email: "kotaprobolinggo@kemenag.go.id",
            contactType: "PPID",
            areaServed: "ID-JI",
            availableLanguage: ["id"],
        },
    },
    {
        "@context": "https://schema.org",
        "@type": "ItemList",
        name: "Alur Permohonan Informasi PPID",
        itemListElement: alurPermohonan.map((item, index) => ({
            "@type": "ListItem",
            position: index + 1,
            name: item.judul,
            description: item.desc,
        })),
    },
];
---

<style>
    [data-anim="down"] {
        animation: fadeDown 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both;
    }
    [data-anim="up"] {
        animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
    }

    @keyframes fadeDown {
        from {
            opacity: 0;
            transform: translateY(-12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    [data-reveal] {
        opacity: 0;
        transition:
            opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
            transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    [data-reveal="up"] {
        transform: translateY(24px);
    }
    [data-reveal].revealed {
        opacity: 1;
        transform: none;
    }
    [data-delay="1"] {
        transition-delay: 0.06s;
    }
    [data-delay="2"] {
        transition-delay: 0.12s;
    }
    [data-delay="3"] {
        transition-delay: 0.18s;
    }
    [data-delay="4"] {
        transition-delay: 0.24s;
    }
</style>

<BaseLayout
    title="PPID"
    description="Pejabat Pengelola Informasi dan Dokumentasi Kemenag Kota Probolinggo untuk layanan keterbukaan informasi publik."
    ogDescription="Akses informasi tentang PPID, kategori informasi publik, alur permohonan, dan kontak layanan Kemenag Kota Probolinggo."
    structuredData={structuredData}
>
    <HeroPpid client:load />

    <!-- ── Apa itu PPID ────────────────────────────────── -->
    <section class="mb-14">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-14 items-start">
            <div data-anim="up" class="lg:col-span-3">
                <div class="flex items-center gap-3 mb-4 mt-5">
                    <div class="w-1 h-5 bg-green shrink-0"></div>
                    <span class="text-[11px] font-black uppercase tracking-[0.18em] text-green">
                        Tentang PPID
                    </span>
                </div>
                <h2 class="text-2xl sm:text-3xl font-extrabold uppercase tracking-tight text-ink mb-4 leading-tight">
                    Keterbukaan Informasi Publik
                </h2>
                <p class="text-sm text-ink/60 leading-relaxed mb-4">
                    PPID (Pejabat Pengelola Informasi dan Dokumentasi) adalah
                    pejabat yang bertugas menyimpan, mendokumentasikan,
                    menyediakan, dan memberikan pelayanan informasi publik di
                    lingkungan Kantor Kementerian Agama Kota Probolinggo.
                </p>
                <p class="text-sm text-ink/60 leading-relaxed">
                    Dasar hukum:{" "}
                    <strong class="text-ink">UU Nomor 14 Tahun 2008</strong>{" "}
                    tentang Keterbukaan Informasi Publik dan{" "}
                    <strong class="text-ink">PP Nomor 61 Tahun 2010</strong>{" "}
                    tentang Pelaksanaan UU KIP.
                </p>
            </div>

            <!-- Kontak PPID -->
            <div data-anim="up" data-delay="1" class="lg:col-span-2">
                <div class="border border-ink/10 bg-cream p-6">
                    <h3 class="text-[11px] font-black uppercase tracking-wider text-ink/40 mb-4">
                        Kontak PPID
                    </h3>
                    <div class="space-y-3">
                        <div class="flex items-start gap-3">
                            <svg
                                viewBox="0 0 24 24"
                                width="16"
                                height="16"
                                fill="currentColor"
                                class="shrink-0 text-green mt-0.5"
                            >
                                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"></path>
                            </svg>
                            <div>
                                <p class="text-[10px] text-ink/35 font-semibold uppercase tracking-wider mb-0.5">
                                    Alamat
                                </p>
                                <p class="text-xs text-ink/70 leading-relaxed">
                                    Jl. Mastrip No 323, Kanigaran
                                    <br />
                                    Kota Probolinggo, Jawa Timur 67213
                                </p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <svg
                                viewBox="0 0 24 24"
                                width="16"
                                height="16"
                                fill="currentColor"
                                class="shrink-0 text-green mt-0.5"
                            >
                                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path>
                            </svg>
                            <div>
                                <p class="text-[10px] text-ink/35 font-semibold uppercase tracking-wider mb-0.5">
                                    WhatsApp
                                </p>
                                <a
                                    href="https://wa.me/6287838100425"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-xs text-green hover:underline"
                                >
                                    +62 878-3810-0425
                                </a>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <svg
                                viewBox="0 0 24 24"
                                width="16"
                                height="16"
                                fill="currentColor"
                                class="shrink-0 text-green mt-0.5"
                            >
                                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"></path>
                            </svg>
                            <div>
                                <p class="text-[10px] text-ink/35 font-semibold uppercase tracking-wider mb-0.5">
                                    Email
                                </p>
                                <p class="text-xs text-ink/70">
                                    kotaprobolinggo@kemenag.go.id
                                </p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <svg
                                viewBox="0 0 24 24"
                                width="16"
                                height="16"
                                fill="currentColor"
                                class="shrink-0 text-green mt-0.5"
                            >
                                <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"></path>
                            </svg>
                            <div>
                                <p class="text-[10px] text-ink/35 font-semibold uppercase tracking-wider mb-0.5">
                                    Jam Pelayanan
                                </p>
                                <p class="text-xs text-ink/70">
                                    Senin – Kamis 07.30 – 16.00 WIB, Jumat 07.00
                                    – 16.30 WIB
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ── Kategori Informasi ──────────────────────────── -->
    <section id="tentang-ppid" class="mb-14 scroll-mt-24">
        <a
            href="/portal"
            data-anim="down"
            class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-ink/35 hover:text-green transition-colors mb-6"
        >
            <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
                <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"></path>
            </svg>
            Portal
        </a>
        <div class="mb-8">
            <div data-reveal="up" class="flex items-center gap-3 mb-3">
                <div class="w-1 h-5 bg-green"></div>
                <span class="text-[11px] font-black uppercase tracking-[0.18em] text-green">
                    Kategori Informasi
                </span>
            </div>
            <h2
                data-reveal="up"
                data-delay="1"
                class="text-2xl sm:text-3xl font-extrabold uppercase tracking-tight text-ink"
            >
                Jenis Informasi Publik
            </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {kategoris.map((k, i) => (
                <div
                    data-reveal="up"
                    data-delay={String((i % 2) + 1)}
                    class="border border-ink/10 bg-cream p-5"
                >
                    <div class="flex items-start gap-3 mb-3">
                        <div class="w-10 h-10 shrink-0 bg-ink/5 flex items-center justify-center">
                            <svg
                                viewBox="0 0 24 24"
                                width="20"
                                height="20"
                                fill="currentColor"
                                class="text-green/70"
                            >
                                <Fragment set:html={k.icon} />
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-sm font-bold text-ink mb-0.5">
                                {k.label}
                            </h3>
                            <p class="text-xs text-ink/50 leading-relaxed">
                                {k.desc}
                            </p>
                        </div>
                    </div>
                    <ul class="space-y-1 pl-1">
                        {k.contoh.map((c) => (
                            <li class="flex items-start gap-2 text-xs text-ink/50">
                                <span class="shrink-0 w-1 h-1 rounded-full bg-ink/25 mt-[5px]" />
                                {c}
                            </li>
                        ))}
                    </ul>
                    {"href" in k && k.href && (
                        <a
                            href={k.href}
                            class="mt-3 inline-flex items-center gap-1 text-[11px] font-bold uppercase tracking-wider text-green hover:underline"
                        >
                            Lihat {k.label}
                            <svg
                                viewBox="0 0 24 24"
                                width="12"
                                height="12"
                                fill="currentColor"
                            >
                                <path d="M6.4 18L5 16.6 14.6 7H6V5h12v12h-2V8.4z" />
                            </svg>
                        </a>
                    )}
                </div>
            ))}
        </div>
    </section>

    <!-- ── Informasi Tersedia (Informasi Kelembagaan) ──── -->
    <section class="mb-14">
        <div class="mb-8">
            <div data-reveal="up" class="flex items-center gap-3 mb-3">
                <div class="w-1 h-5 bg-green"></div>
                <span class="text-[11px] font-black uppercase tracking-[0.18em] text-green">
                    Informasi Kelembagaan
                </span>
            </div>
            <h2
                data-reveal="up"
                data-delay="1"
                class="text-2xl sm:text-3xl font-extrabold uppercase tracking-tight text-ink"
            >
                Informasi Tersedia
            </h2>
            <p
                data-reveal="up"
                data-delay="2"
                class="text-sm text-ink/50 mt-2 max-w-lg"
            >
                Akses berbagai informasi resmi seputar kelembagaan, layanan, dan
                program Kantor Kementerian Agama Kota Probolinggo.
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <!-- Informasi Berkala -->
            <a
                href="/ppid/informasi-berkala"
                data-reveal="up"
                data-delay="1"
                class="group flex items-start gap-4 border border-ink/10 bg-cream p-5 hover:border-green transition-colors"
            >
                <div class="w-12 h-12 shrink-0 bg-ink/5 border border-ink/10 flex items-center justify-center group-hover:bg-green group-hover:border-green transition-colors">
                    <Icon
                        name="mdi:folder-multiple-outline"
                        class="text-ink/40 group-hover:text-white transition-colors w-[22px] h-[22px]"
                    />
                </div>
                <div class="flex-1 min-w-0">
                    <h3 class="text-sm font-bold text-ink uppercase tracking-wide mb-1 group-hover:text-green transition-colors">
                        Informasi Berkala
                    </h3>
                    <p class="text-xs text-ink/50 leading-relaxed line-clamp-2">
                        Profil kelembagaan, perencanaan & anggaran, hingga
                        laporan kinerja dan kanal pengaduan masyarakat.
                    </p>
                </div>
                <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="currentColor"
                    class="shrink-0 text-ink/20 group-hover:text-green transition-colors mt-1 group-hover:translate-x-0.5 transition-transform"
                >
                    <path d="M6.4 18L5 16.6 14.6 7H6V5h12v12h-2V8.4z" />
                </svg>
            </a>

            <!-- Statistik -->
            <a
                href="/ppid/statistik"
                data-reveal="up"
                data-delay="4"
                class="group flex items-start gap-4 border border-ink/10 bg-cream p-5 hover:border-green transition-colors"
            >
                <div class="w-12 h-12 shrink-0 bg-ink/5 border border-ink/10 flex items-center justify-center group-hover:bg-green group-hover:border-green transition-colors">
                    <Icon
                        name="mdi:bar-chart"
                        class="text-ink/40 group-hover:text-white transition-colors"
                    />
                </div>
                <div class="flex-1 min-w-0">
                    <h3 class="text-sm font-bold text-ink uppercase tracking-wide mb-1 group-hover:text-green transition-colors">
                        Statistik
                    </h3>
                    <p class="text-xs text-ink/50 leading-relaxed line-clamp-2">
                        Berbagai jenis data statistik yang tersedia untuk umum.
                    </p>
                </div>
                <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="currentColor"
                    class="shrink-0 text-ink/20 group-hover:text-green transition-colors mt-1 group-hover:translate-x-0.5 transition-transform"
                >
                    <path d="M6.4 18L5 16.6 14.6 7H6V5h12v12h-2V8.4z" />
                </svg>
            </a>

            <!-- Informasi Madrasah -->
            <a
                href="/ppid/madrasah"
                data-reveal="up"
                data-delay="1"
                class="group flex items-start gap-4 border border-ink/10 bg-cream p-5 hover:border-green transition-colors"
            >
                <div class="w-12 h-12 shrink-0 bg-ink/5 border border-ink/10 flex items-center justify-center group-hover:bg-green group-hover:border-green transition-colors">
                    <svg
                        viewBox="0 0 24 24"
                        width="22"
                        height="22"
                        fill="currentColor"
                        class="text-ink/40 group-hover:text-white transition-colors"
                    >
                        <path d="M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3 1 9l11 6 9-4.91V17h2V9L12 3z" />
                    </svg>
                </div>
                <div class="flex-1 min-w-0">
                    <h3 class="text-sm font-bold text-ink uppercase tracking-wide mb-1 group-hover:text-green transition-colors">
                        Informasi Madrasah
                    </h3>
                    <p class="text-xs text-ink/50 leading-relaxed line-clamp-2">
                        Data dan informasi seputar madrasah di wilayah Kota
                        Probolinggo.
                    </p>
                </div>
                <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="currentColor"
                    class="shrink-0 text-ink/20 group-hover:text-green transition-colors mt-1 group-hover:translate-x-0.5 transition-transform"
                >
                    <path d="M6.4 18L5 16.6 14.6 7H6V5h12v12h-2V8.4z" />
                </svg>
            </a>

            <!-- Informasi KUA -->
            <a
                href="/ppid/kua"
                data-reveal="up"
                data-delay="2"
                class="group flex items-start gap-4 border border-ink/10 bg-cream p-5 hover:border-green transition-colors"
            >
                <div class="w-12 h-12 shrink-0 bg-ink/5 border border-ink/10 flex items-center justify-center group-hover:bg-green group-hover:border-green transition-colors">
                    <svg
                        viewBox="0 0 24 24"
