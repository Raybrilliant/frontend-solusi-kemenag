---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import ItemBerkala from "../../../components/ppid/ItemBerkala.astro";
import {
    informasiBerkala,
    type InformasiBerkalaGrup,
} from "../../../lib/ppid-informasi-berkala";

const BACKEND_URL = process.env.BACKEND_URL ?? "http://localhost:3000";

type BerkalaApiRow = {
    grup: string;
    itemId: string;
    label: string;
    desc: string;
    icon: string;
    penjelasan: string;
    profilLink: string | null;
    profilLinkLabel: string | null;
    tautanEksternal: { label: string; href: string; desc: string }[];
    infoPublikasi: string | null;
    dokumen: { judul: string; url: string }[];
    aktif: boolean;
    urutan: number;
};

// Data dari backend; fallback ke data statis bila backend tidak tersedia.
let grupTampil: InformasiBerkalaGrup[] = informasiBerkala;
try {
    const res = await fetch(`${BACKEND_URL}/api/v1/informasi-berkala`);
    if (res.ok) {
        const json = (await res.json()) as {
            success: boolean;
            data: BerkalaApiRow[];
        };
        if (json.success && json.data.length > 0) {
            grupTampil = informasiBerkala.map((grup) => ({
                ...grup,
                items: json.data
                    .filter(
                        (row) => row.grup === grup.id && row.aktif !== false,
                    )
                    .sort((a, b) => a.urutan - b.urutan)
                    .map((row) => ({
                        id: row.itemId,
                        label: row.label,
                        desc: row.desc,
                        icon: row.icon || "mdi:file-document-outline",
                        penjelasan: row.penjelasan,
                        profilLink: row.profilLink ?? undefined,
                        profilLinkLabel: row.profilLinkLabel ?? undefined,
                        tautanEksternal: row.tautanEksternal,
                        infoPublikasi: row.infoPublikasi ?? undefined,
                        dokumen: row.dokumen.map((d, di) => ({
                            id: `${row.itemId}-${di}`,
                            judul: d.judul,
                            fileUrl: d.url || undefined,
                        })),
                    })),
            }));
        }
    }
} catch {
    // Backend tidak tersedia → pakai data statis
}

const semuaItem = grupTampil.flatMap((g) => g.items);

const pageUrl = `${Astro.url.origin}/ppid/informasi-berkala`;
const structuredData = [
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
            {
                "@type": "ListItem",
                position: 1,
                name: "Beranda",
                item: `${Astro.url.origin}`,
            },
            {
                "@type": "ListItem",
                position: 2,
                name: "PPID",
                item: `${Astro.url.origin}/ppid`,
            },
            {
                "@type": "ListItem",
                position: 3,
                name: "Informasi Berkala",
                item: pageUrl,
            },
        ],
    },
    {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        name: "Informasi Berkala PPID Kemenag Kota Probolinggo",
        description:
            "Informasi wajib umum yang diumumkan secara berkala oleh PPID Kemenag Kota Probolinggo: profil kelembagaan, perencanaan dan penganggaran, laporan kinerja dan keuangan, hingga kanal pengaduan masyarakat.",
        url: pageUrl,
        isPartOf: {
            "@type": "WebSite",
            name: "Kemenag Kota Probolinggo",
            url: Astro.url.origin,
        },
    },
    {
        "@context": "https://schema.org",
        "@type": "ItemList",
        name: "Daftar Informasi Berkala",
        itemListElement: semuaItem.map((item, index) => ({
            "@type": "ListItem",
            position: index + 1,
            name: item.label,
            description: item.desc,
            url: `${pageUrl}#${item.id}`,
        })),
    },
];
---

<style>
    [data-anim="down"] {
        animation: fadeDown 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both;
    }
    [data-anim="up"] {
        animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
    }

    @keyframes fadeDown {
        from {
            opacity: 0;
            transform: translateY(-12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    [data-reveal] {
        opacity: 0;
        transition:
            opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
            transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    [data-reveal="up"] {
        transform: translateY(24px);
    }
    [data-reveal].revealed {
        opacity: 1;
        transform: none;
    }
    [data-delay="1"] {
        transition-delay: 0.06s;
    }
    [data-delay="2"] {
        transition-delay: 0.12s;
    }
    [data-delay="3"] {
        transition-delay: 0.18s;
    }
    [data-delay="4"] {
        transition-delay: 0.24s;
    }

    .section-anchor {
        scroll-margin-top: 5rem;
    }

    #toc-sticky nav {
        box-shadow: 0 10px 30px -12px rgba(17, 17, 17, 0.25);
        transform: translateY(-140%);
        opacity: 0;
        visibility: hidden;
        transition:
            transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
            opacity 0.3s ease,
            visibility 0s linear 0.4s;
    }

    #toc-sticky.toc-show nav {
        transform: translateY(0);
        opacity: 1;
        visibility: visible;
        transition:
            transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
            opacity 0.3s ease;
    }

    .toc-scroll {
        scrollbar-width: none;
    }
    .toc-scroll::-webkit-scrollbar {
        display: none;
    }

    .toc-chip.toc-active {
        background-color: #111111;
        border-color: #111111;
        color: #f6f1e8;
    }
</style>

<BaseLayout
    title="Informasi Berkala PPID"
    description="Informasi Berkala PPID Kemenag Kota Probolinggo: profil kelembagaan, perencanaan dan penganggaran, laporan kinerja dan keuangan, hingga kanal pengaduan masyarakat."
    ogDescription="Daftar Informasi Berkala yang wajib diumumkan secara berkala oleh PPID Kementerian Agama Kota Probolinggo."
    structuredData={structuredData}
>
    <!-- ── Page header ────────────────────────────── -->
    <div id="page-head" data-anim="down" class="pt-8 pb-6">
        <a
            href="/ppid"
            class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-ink/35 hover:text-green transition-colors mb-4"
        >
            <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
                <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" />
            </svg>
            PPID
        </a>
        <div class="flex items-center gap-3 mb-2">
            <div class="w-1 h-7 bg-green shrink-0"></div>
            <h1 class="text-4xl font-extrabold uppercase tracking-tight text-ink">
                Informasi Berkala
            </h1>
        </div>
        <p class="text-sm text-ink/45 mt-1 ml-4 max-w-2xl">
            Informasi wajib umum yang disediakan dan diumumkan secara berkala
            sesuai UU Nomor 14 Tahun 2008 tentang Keterbukaan Informasi Publik.
        </p>
    </div>

    <!-- ── Sticky nav bar (muncul saat halaman di-scroll) ── -->
    <div id="toc-sticky" class="sticky top-3 z-40 h-0 overflow-visible">
        <nav
            aria-label="Navigasi cepat Informasi Berkala"
            class="border border-ink/10 bg-cream/95 backdrop-blur-sm"
        >
            <div
                id="toc-chips"
                class="flex items-center gap-1.5 overflow-x-auto px-3 py-2.5 toc-scroll"
            >
                {grupTampil.map((grup) => (
                    <>
                        <span class="shrink-0 select-none pl-1 pr-0.5 text-[9px] font-black uppercase tracking-wider text-ink/30">
                            {grup.label}
                        </span>
                        {grup.items.map((item) => (
                            <a
                                href={`#${item.id}`}
                                data-toc-chip={item.id}
                                class="toc-chip shrink-0 whitespace-nowrap border border-ink/15 px-2.5 py-1.5 text-[10px] font-bold uppercase tracking-wide text-ink/50 transition-colors hover:border-green hover:text-green"
                            >
                                {item.label}
                            </a>
                        ))}
                    </>
                ))}
            </div>
        </nav>
    </div>

    <!-- ── Daftar isi ─────────────────────────────── -->
    <nav
        data-anim="up"
        aria-label="Daftar Informasi Berkala"
        class="border border-ink/10 bg-cream p-5 sm:p-6 mb-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-8"
    >
        {grupTampil.map((grup) => (
            <div>
                <p class="text-[10px] font-black uppercase tracking-wider text-green mb-2.5">
                    {grup.label}
                </p>
                <ul class="space-y-1.5">
                    {grup.items.map((item) => (
                        <li>
                            <a
                                href={`#${item.id}`}
                                class="text-xs text-ink/55 hover:text-green transition-colors leading-snug block"
                            >
                                {item.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        ))}
    </nav>

    <!-- ── Grup & item informasi ──────────────────────── -->
    {grupTampil.map((grup, gi) => (
        <section id={grup.id} class="section-anchor mb-4">
            <div class="mb-4">
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-1 h-7 bg-green shrink-0" />
                    <h2 class="text-2xl sm:text-3xl font-extrabold uppercase tracking-tight text-ink">
                        {grup.label}
                    </h2>
                </div>
                <p class="text-sm text-ink/45 ml-4 max-w-2xl leading-relaxed">
                    {grup.desc}
                </p>
            </div>

            <div class="border-t border-ink/8">
                {grup.items.map((item) => (
                    <ItemBerkala item={item} />
                ))}
            </div>
        </section>
    ))}

    <!-- ── CTA kembali ────────────────────────────────── -->
    <div data-reveal="up" class="flex flex-col sm:flex-row gap-3 pt-12 pb-4">
        <a
            href="/ppid"
            class="group inline-flex items-center justify-center gap-2 px-5 py-3 text-[11px] font-black uppercase tracking-wider border border-ink/15 text-ink/60 hover:border-green hover:text-green transition-colors"
        >
            <Icon
                name="mdi:arrow-right"
                class="w-3.5 h-3.5 rotate-180 group-hover:-translate-x-0.5 transition-transform"
            />
            Kembali ke Halaman PPID
        </a>
        <a
            href="/ppid/regulasi"
            class="group inline-flex items-center justify-center gap-2 px-5 py-3 text-[11px] font-black uppercase tracking-wider border border-ink/15 text-ink/60 hover:border-green hover:text-green transition-colors"
        >
            Lihat Regulasi &amp; Peraturan
            <Icon
                name="mdi:arrow-right"
                class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform"
            />
        </a>
    </div>
</BaseLayout>

<script>
    {
        const obs = new IntersectionObserver(
            (entries) =>
                entries.forEach((e) => {
                    if (e.isIntersecting) {
                        e.target.classList.add("revealed");
                        obs.unobserve(e.target);
                    }
                }),
            { threshold: 0.1, rootMargin: "0px 0px -30px 0px" },
        );
        document
            .querySelectorAll("[data-reveal]")
            .forEach((el) => obs.observe(el));

        // Sticky nav bar: tampil setelah header halaman terlewati scroll
        const tocSticky = document.getElementById("toc-sticky");
        const pageHead = document.getElementById("page-head");
        if (tocSticky && pageHead) {
            new IntersectionObserver(([e]) =>
                tocSticky.classList.toggle("toc-show", !e.isIntersecting),
            ).observe(pageHead);
        }

        // Scroll spy: sorot chip sesuai section yang sedang terlihat
        const chips = new Map();
        document.querySelectorAll("[data-toc-chip]").forEach((a) => {
            chips.set(a.getAttribute("data-toc-chip"), a);
        });
        const chipsContainer = document.getElementById("toc-chips");
        if (chips.size > 0) {
            const spy = new IntersectionObserver(
                (entries) => {
                    entries.forEach((e) => {
                        if (!e.isIntersecting) return;
                        const chip = chips.get(e.target.id);
                        if (!chip) return;
                        chips.forEach((c) => c.classList.remove("toc-active"));
                        chip.classList.add("toc-active");
                        // Scroll kontainer chip secara manual — scrollIntoView
                        // membatalkan smooth anchor scroll yang sedang berjalan
                        // sehingga halaman ter-stop sebelum sampai ke tujuan.
                        if (chipsContainer) {
                            const target =
                                chip.offsetLeft -
                                chipsContainer.clientWidth / 2 +
                                chip.clientWidth / 2;
                            chipsContainer.scrollTo({
                                left: Math.max(0, target),
                                behavior: "smooth",
                            });
                        }
                    });
                },
                { rootMargin: "-25% 0px -70% 0px" },
            );
            document
                .querySelectorAll("article[id]")
                .forEach((el) => spy.observe(el));
        }
    }
</script>
