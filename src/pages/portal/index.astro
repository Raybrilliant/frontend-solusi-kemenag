---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { toUploadProxyUrl } from "../../lib/upload-url";
import { categoryColor, categoryAccent } from "../../lib/berita-kategori";
import kemenagImage from "../../assets/images/kemenag.png";

const BACKEND_URL = process.env.BACKEND_URL ?? "http://localhost:3000";

Astro.response.headers.set(
    "Cache-Control",
    "public, max-age=300, stale-while-revalidate=600",
);

// Hierarchy order — strongest to weakest
const TYPE_ORDER = [
    "UU",
    "PERPU",
    "PP",
    "PERPRES",
    "INPRES",
    "PERMEN",
    "PMA",
    "KMA",
    "PERDIRJEN",
    "KEPDIRJEN",
    "SE",
    "SKB",
];

// Fetch berita (6 terbaru) dan regulasi secara paralel
const [beritaRaw, regulasiRaw] = await Promise.allSettled([
    fetch(`${BACKEND_URL}/api/v1/berita/?limit=6`).then((r) =>
        r.ok ? r.json() : { data: [] },
    ),
    fetch(`${BACKEND_URL}/api/v1/regulasi/?limit=100`).then((r) =>
        r.ok ? r.json() : { data: [] },
    ),
]);

const berita = (
    (beritaRaw.status === "fulfilled" ? beritaRaw.value?.data : null) ?? []
).map((b: any) => ({
    ...b,
    thumbnail: toUploadProxyUrl(b.thumbnail) || b.thumbnail,
}));

const regulasiAll = (
    (regulasiRaw.status === "fulfilled" ? regulasiRaw.value?.data : null) ?? []
).map((r: any) => ({
    ...r,
    fileUrl: toUploadProxyUrl(r.fileUrl) || r.fileUrl,
}));

// Sort by legal hierarchy then take 6
const regulasi = [...regulasiAll]
    .sort((a: any, b: any) => {
        const ai = TYPE_ORDER.indexOf((a.type ?? "").toUpperCase());
        const bi = TYPE_ORDER.indexOf((b.type ?? "").toUpperCase());
        if (ai === -1 && bi === -1) return 0;
        if (ai === -1) return 1;
        if (bi === -1) return -1;
        return ai - bi;
    })
    .slice(0, 6);

function formatDate(dateStr: string | null) {
    if (!dateStr) return "";
    return new Date(dateStr).toLocaleDateString("id-ID", {
        day: "numeric",
        month: "long",
        year: "numeric",
    });
}

// Fetch semua kategori unik dari berita yang ada
let rawKategori: string[] = [];
try {
    const katRes = await fetch(`${BACKEND_URL}/api/v1/berita/?limit=500`);
    if (katRes.ok) {
        const katData = await katRes.json();
        rawKategori = [
            ...new Set(
                ((katData?.data ?? []) as any[])
                    .map((b) =>
                        String(b.kategori ?? "")
                            .trim()
                            .toLowerCase(),
                    )
                    .filter(Boolean),
            ),
        ];
        rawKategori.sort();
    }
} catch {}

function regulasiBadge(type: string) {
    const t = type.toUpperCase();
    switch (t) {
        case "PMA":
        case "PERMEN":
            return "bg-green/20 text-green";
        case "KMA":
            return "bg-yellow/20 text-yellow";
        case "PP":
        case "PERPRES":
        case "INPRES":
            return "bg-white/15 text-white/70";
        case "UU":
        case "PERPU":
            return "bg-white/20 text-white";
        default:
            return "bg-white/10 text-white/50";
    }
}

const structuredData = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Portal Resmi Kemenag Kota Probolinggo",
    description:
        "Portal resmi berisi berita, regulasi, profil, statistik, PPID, KUA, dan informasi publik Kantor Kementerian Agama Kota Probolinggo.",
    url: `${Astro.url.origin}/portal`,
    isPartOf: {
        "@type": "WebSite",
        name: "Kemenag Kota Probolinggo",
        url: Astro.url.origin,
    },
};
---

<style>
    /* ── Dot grid hero ───────────────────────────────────── */
    .hero-dots {
        background-image: radial-gradient(
            circle,
            rgba(255, 255, 255, 0.16) 1px,
            transparent 1px
        );
        background-size: 28px 28px;
    }

    /* ── Scroll hint bounce ──────────────────────────────── */
    @keyframes bounce-y {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(6px);
        }
    }
    .bounce-arrow {
        animation: bounce-y 1.6s ease-in-out infinite;
    }

    /* ── Hero entrance animations ────────────────────────── */
    [data-hero="badge"] {
        animation: fadeDown 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
    }
    [data-hero="h1"] {
        animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
    }
    [data-hero="sub"] {
        animation: fadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
    }
    [data-hero="hint"] {
        animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.5s both;
    }

    /* ── Scroll reveal ───────────────────────────────────── */
    [data-reveal] {
        opacity: 0;
        transition:
            opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
            transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform, opacity;
    }
    [data-reveal="up"] {
        transform: translateY(32px);
    }
    [data-reveal="left"] {
        transform: translateX(-32px);
    }
    [data-reveal].revealed {
        opacity: 1;
        transform: none;
    }
    [data-delay="1"] {
        transition-delay: 0.08s;
    }
    [data-delay="2"] {
        transition-delay: 0.16s;
    }
    [data-delay="3"] {
        transition-delay: 0.24s;
    }
    [data-delay="4"] {
        transition-delay: 0.32s;
    }
    [data-delay="5"] {
        transition-delay: 0.4s;
    }
    [data-delay="6"] {
        transition-delay: 0.48s;
    }

    @keyframes fadeDown {
        from {
            opacity: 0;
            transform: translateY(-14px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(24px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── News card hover ─────────────────────────────────── */
    .news-card {
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease;
    }
    .news-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
    }
</style>

<BaseLayout
    title="Portal Resmi"
    description="Portal resmi Kantor Kementerian Agama Kota Probolinggo berisi berita, regulasi, profil, statistik, PPID, dan informasi publik."
    ogTitle="Portal Resmi Kemenag Kota Probolinggo"
    ogDescription="Jelajahi berita resmi, regulasi, PPID, profil, statistik, dan layanan publik Kemenag Kota Probolinggo."
    structuredData={structuredData}
>
    <!-- ══ HERO ════════════════════════════════════════════ -->
    <section
        id="hero-section"
        class="-mx-4 sm:-mx-8 md:-mx-14 lg:-mx-20"
        style="height: 190vh;"
    >
        <div
            class="sticky top-0 h-screen overflow-hidden flex flex-col"
            style="background:#0a1a0c;"
        >
            <!-- Background patterns -->
            <div class="absolute inset-0 hero-dots pointer-events-none"></div>
            <div class="absolute -bottom-32 -left-32 w-[500px] h-[500px] bg-green/15 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute top-1/4 right-0 w-80 h-80 bg-green/8 rounded-full blur-3xl pointer-events-none"></div>

            <!-- ── Welcome text ───────────────────────── -->
            <div class="relative z-10 flex flex-col items-center text-center pt-16 sm:pt-20 md:pt-24 px-4 sm:px-8 md:px-16 lg:px-24">
                <!-- <div data-hero="badge"
                     class="inline-flex items-center gap-2 bg-green/20 border border-green/30 rounded-full px-4 py-1.5 mb-5">
                    <span class="w-1.5 h-1.5 rounded-full bg-green animate-pulse shrink-0"></span>
                    <span class="text-[11px] font-bold text-green/80 uppercase tracking-[0.16em]">
                        Portal Resmi — Kemenag Kota Probolinggo
                    </span>
                </div> -->

                <h1
                    data-hero="h1"
                    class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white uppercase leading-tight tracking-tight max-w-5xl"
                >
                    Selamat Datang di
                    <br />
                    <span class="text-green">Portal Resmi</span>
                    <br />
                    Kementerian Agama <br /> Kota Probolinggo
                </h1>

                <p
                    data-hero="sub"
                    class="mt-4 text-sm sm:text-base text-white/45 max-w-xl leading-relaxed"
                >
                    Informasi resmi, berita terkini, regulasi, dan layanan
                    publik Kantor Kementerian Agama Kota Probolinggo dalam satu
                    portal.
                </p>

                <div
                    data-hero="hint"
                    id="scroll-hint"
                    class="mt-8 flex flex-col items-center gap-2 transition-opacity duration-300"
                >
                    <span class="text-[11px] font-semibold text-white/25 uppercase tracking-widest">
                        Scroll untuk menjelajahi
                    </span>
                    <div class="bounce-arrow">
                        <svg
                            viewBox="0 0 24 24"
                            width="18"
                            height="18"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            class="text-white/25"
                        >
                            <path d="m6 9 6 6 6-6" />
                        </svg>
                    </div>
                </div>
            </div>

            <!-- ── Parallax image ─────────────────────── -->
            <Image
                id="parallax-img"
                src={kemenagImage}
                alt="Kantor Kementerian Agama Kota Probolinggo"
                class="absolute left-0 right-0 bottom-0 w-full object-cover object-bottom pointer-events-none select-none"
                style="filter: grayscale(100%) brightness(0.5); will-change: transform;"
                widths={[768, 1024, 1280, 1600, 1920]}
                sizes="100vw"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                format="webp"
            />

            <!-- Fade to dark at bottom -->
            <div
                class="absolute bottom-0 left-0 right-0 h-36 pointer-events-none"
                style="background: linear-gradient(to bottom, transparent, #0a1a0c);"
            ></div>
        </div>
    </section>

    <!-- ══ BERITA TERBARU ══════════════════════════════════ -->
    <section class="py-14 md:py-20">
        <div class="mb-10 md:mb-12">
            <div data-reveal="up" class="flex items-center gap-3 mb-3">
                <div class="w-1 h-6 bg-green"></div>
                <span class="text-[11px] font-black uppercase tracking-[0.18em] text-green">
                    Berita & Informasi
                </span>
            </div>
            <h2
                data-reveal="up"
                data-delay="1"
                class="text-3xl sm:text-4xl md:text-5xl font-extrabold uppercase tracking-tight text-ink"
            >
                Berita Terbaru
            </h2>
            <p
                data-reveal="up"
                data-delay="2"
                class="text-sm text-ink/50 mt-2 max-w-lg"
            >
                Informasi dan pengumuman resmi terkini dari Kantor Kementerian
                Agama Kota Probolinggo.
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {berita.length === 0 ? (
                <p class="col-span-3 text-center py-16 text-sm text-ink/30 font-medium uppercase tracking-wider">
                    Belum ada berita
                </p>
            ) : (
                berita.map((b: any, i: number) => (
                    <a
                        href={`/portal/berita/${b.slug}`}
                        data-reveal="up"
                        data-delay={String((i % 3) + 1)}
                        class="news-card bg-cream border border-ink/10 flex flex-col cursor-pointer group overflow-hidden"
                    >
                        <!-- Thumbnail -->
                        <div class="relative overflow-hidden h-44 shrink-0 bg-ink/5">
                            {b.thumbnail ? (
                                <img
                                    src={b.thumbnail}
                                    alt={b.judul}
                                    class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-500 ease-out"
                                    loading="lazy"
                                />
                            ) : (
                                <div class="w-full h-full flex items-center justify-center">
                                    <svg
                                        viewBox="0 0 24 24"
                                        width="32"
                                        height="32"
                                        fill="currentColor"
                                        class="text-ink/10"
                                    >
                                        <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" />
                                    </svg>
                                </div>
                            )}
                            <span
                                class={`absolute top-3 left-3 text-[10px] font-black uppercase tracking-wider px-2 py-1 ${categoryColor(b.kategori)}`}
                            >
                                {b.kategori}
                            </span>
                        </div>

                        <!-- Color accent bar -->
                        <div
                            class={`h-0.5 w-full shrink-0 ${categoryAccent(b.kategori)}`}
                        />

                        <div class="p-5 md:p-6 flex flex-col flex-1">
                            <span class="text-[11px] text-ink/35 font-medium mb-3 block">
                                {formatDate(b.publishedAt ?? b.createdAt)}
                            </span>

                            <h3 class="text-sm sm:text-base font-bold text-ink leading-snug mb-2 group-hover:text-green transition-colors flex-1">
                                {b.judul}
                            </h3>

                            <p class="text-xs sm:text-[13px] text-ink/50 leading-relaxed line-clamp-3">
                                {b.ringkasan}
                            </p>

                            <div class="flex items-center gap-1.5 mt-4 text-[11px] font-bold uppercase tracking-wider text-green/60 group-hover:text-green transition-colors">
                                Selengkapnya
                                <svg
                                    viewBox="0 0 24 24"
                                    width="12"
                                    height="12"
                                    fill="currentColor"
                                    class="group-hover:translate-x-1 transition-transform"
                                >
                                    <path d="M6.4 18L5 16.6 14.6 7H6V5h12v12h-2V8.4z" />
                                </svg>
                            </div>
                        </div>
                    </a>
                ))
            )}
        </div>

        <div data-reveal="up" class="mt-8 text-center">
            <a
                href="/portal/berita"
                class="inline-flex items-center gap-2 border border-ink/20 bg-cream px-6 py-3 text-sm font-bold uppercase tracking-wide hover:border-green hover:text-green transition-colors"
            >
                Lihat Semua Berita
                <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="currentColor"
                >
                    <path d="M6.4 18L5 16.6 14.6 7H6V5h12v12h-2V8.4z" />
                </svg>
            </a>
        </div>
    </section>

    <!-- ══ REGULASI ════════════════════════════════════════ -->
    <section
        class="-mx-4 sm:-mx-8 md:-mx-14 lg:-mx-20 px-4 sm:px-8 md:px-14 lg:px-20 py-14 md:py-20"
        style="background:#111111; color:#f6f1e8;"
    >
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-16 items-start">
            <!-- Left: heading -->
            <div class="lg:col-span-2 lg:sticky lg:top-10">
                <div data-reveal="left" class="flex items-center gap-3 mb-3">
                    <div class="w-1 h-6 bg-yellow"></div>
                    <span class="text-[11px] font-black uppercase tracking-[0.18em] text-yellow">
                        Hukum & Kebijakan
                    </span>
                </div>
                <h2
                    data-reveal="left"
                    data-delay="1"
                    class="text-3xl sm:text-4xl md:text-5xl font-extrabold uppercase tracking-tight leading-tight mb-4"
                >
                    Regulasi &<br />
                    Peraturan
                </h2>
                <p
                    data-reveal="left"
                    data-delay="2"
                    class="text-sm text-white/45 leading-relaxed max-w-sm"
                >
                    Kumpulan peraturan perundang-undangan yang menjadi landasan
                    hukum pelaksanaan tugas Kementerian Agama.
                </p>
                <a
                    data-reveal="left"
                    data-delay="3"
                    href="/ppid/regulasi"
                    class="inline-flex items-center gap-2 mt-6 border border-white/15 px-5 py-2.5 text-sm font-bold uppercase tracking-wide text-white/60 hover:border-yellow hover:text-yellow transition-colors"
                >
                    Lihat Semua Regulasi
                    <svg
                        viewBox="0 0 24 24"
                        width="13"
                        height="13"
                        fill="currentColor"
                    >
                        <path d="M6.4 18L5 16.6 14.6 7H6V5h12v12h-2V8.4z" />
                    </svg>
                </a>
            </div>

            <!-- Right: list -->
            <div class="lg:col-span-3 flex flex-col divide-y divide-white/8">
                {regulasi.length === 0 ? (
                    <p class="py-10 text-sm text-white/25 font-medium uppercase tracking-wider">
                        Belum ada regulasi
                    </p>
                ) : (
                    regulasi.map((r: any, i: number) => (
                        <a
                            href={r.fileUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            data-reveal="up"
                            data-delay={String((i % 3) + 1)}
                            class="group flex items-start gap-4 py-4 md:py-5 hover:bg-white/3 -mx-2 px-2 transition-colors cursor-pointer"
                        >
                            <span
                                class={`text-[10px] font-black uppercase tracking-wider px-2 py-1 shrink-0 mt-0.5 ${regulasiBadge(r.type)}`}
                            >
                                {r.type}
                            </span>

                            <div class="flex-1 min-w-0">
                                <p class="text-[11px] text-white/30 font-mono mb-0.5">
                                    {r.label}
                                </p>
                                <h3 class="text-sm sm:text-base font-bold text-white group-hover:text-yellow transition-colors leading-snug">
                                    {r.tentang}
                                </h3>
                                {r.description && (
                                    <p class="text-xs text-white/40 mt-0.5 leading-snug line-clamp-1">
                                        {r.description}
                                    </p>
                                )}
                            </div>

                            <svg
                                viewBox="0 0 24 24"
                                width="14"
                                height="14"
                                fill="currentColor"
                                class="shrink-0 text-white/15 group-hover:text-yellow/60 transition-colors mt-1"
                            >
                                <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" />
                            </svg>
                        </a>
                    ))
                )}
            </div>
        </div>
    </section>

    <!-- ══ TOLAK GRATIFIKASI ═══════════════════════════════ -->
    <section
        class="-mx-4 sm:-mx-8 md:-mx-14 lg:-mx-20 px-4 sm:px-8 md:px-14 lg:px-20 py-14 md:py-20 relative overflow-hidden"
        style="background:#F6C744;"
    >
        <!-- Diagonal stripe pattern -->
        <div
            class="absolute inset-0 pointer-events-none"
            style="background: repeating-linear-gradient(45deg, transparent, transparent 20px, rgba(0,0,0,0.03) 20px, rgba(0,0,0,0.03) 40px);"
        ></div>
        <!-- Giant watermark "0" -->
        <div
            class="absolute inset-0 flex items-center justify-center pointer-events-none select-none overflow-hidden"
            style="opacity:0.05;"
        >
            <span style="font-size:22rem; font-weight:900; line-height:1; color:#111;">
                0
            </span>
        </div>

        <div class="relative z-10 max-w-3xl mx-auto text-center">
            <div data-reveal="up" class="inline-flex mb-6">
                <div class="w-16 h-16 bg-ink/10 border-2 border-ink/20 flex items-center justify-center">
                    <svg
                        viewBox="0 0 24 24"
                        width="32"
                        height="32"
                        fill="currentColor"
                        class="text-ink"
                    >
                        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z" />
                    </svg>
                </div>
            </div>

            <h2
                data-reveal="up"
                data-delay="1"
                class="text-3xl sm:text-4xl md:text-5xl font-extrabold uppercase tracking-tight text-ink mb-4 leading-tight"
            >
                Tolak Gratifikasi.
                <br />
                Lawan Korupsi.
            </h2>

            <p
                data-reveal="up"
                data-delay="2"
                class="text-sm sm:text-base text-ink/60 max-w-xl mx-auto leading-relaxed mb-8"
            >
                Kantor Kementerian Agama Kota Probolinggo berkomitmen
                <strong class="text-ink">nol toleransi</strong> terhadap segala
                bentuk gratifikasi, pungutan liar, dan korupsi. Jika Anda
                menemukan pelanggaran, segera laporkan.
            </p>

            <!-- What to report -->
            <div
                data-reveal="up"
                data-delay="3"
                class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-10 text-left"
            >
                {[
                    { icon: "💸", label: "Pungutan Liar (Pungli)" },
                    { icon: "🤝", label: "Permintaan Gratifikasi" },
                    { icon: "⚖️", label: "Penyalahgunaan Jabatan" },
                ].map((p) => (
                    <div class="flex items-center gap-3 bg-ink/8 border border-ink/15 px-4 py-3">
                        <span class="text-xl shrink-0">{p.icon}</span>
                        <span class="text-xs font-bold text-ink uppercase tracking-wide">
                            {p.label}
                        </span>
                    </div>
                ))}
            </div>

            <!-- CTA buttons -->
            <div
                data-reveal="up"
                data-delay="4"
                class="flex flex-col sm:flex-row gap-3 justify-center"
            >
                <a
                    href="/pengaduan"
                    class="inline-flex items-center justify-center gap-2 bg-ink text-cream font-bold text-sm uppercase tracking-wider px-8 py-4 hover:bg-ink/90 active:scale-[0.98] transition-all"
                >
                    <svg
                        viewBox="0 0 24 24"
                        width="16"
                        height="16"
                        fill="currentColor"
                    >
                        <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z" />
                    </svg>
                    Laporkan Sekarang
                </a>
                <a
                    href="https://gol.kpk.go.id"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 bg-ink/10 border-2 border-ink/30 text-ink font-bold text-sm uppercase tracking-wider px-8 py-4 hover:bg-ink/20 active:scale-[0.98] transition-all"
                >
                    <svg
                        viewBox="0 0 24 24"
                        width="14"
                        height="14"
                        fill="currentColor"
                    >
