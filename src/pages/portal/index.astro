---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { toUploadProxyUrl } from "../../lib/upload-url";
import { categoryColor, categoryAccent } from "../../lib/berita-kategori";

const BACKEND_URL = process.env.BACKEND_URL ?? "http://localhost:3000";

Astro.response.headers.set(
    "Cache-Control",
    "public, max-age=300, stale-while-revalidate=600",
);

// Hierarchy order — strongest to weakest
const TYPE_ORDER = [
    "UU",
    "PERPU",
    "PP",
    "PERPRES",
    "INPRES",
    "PERMEN",
    "PMA",
    "KMA",
    "PERDIRJEN",
    "KEPDIRJEN",
    "SE",
    "SKB",
];

// Fetch berita (1 lead + 3 headline + 8 grid), regulasi, dan pengumuman paralel
const [beritaRaw, regulasiRaw, pengumumanRaw] = await Promise.allSettled([
    fetch(`${BACKEND_URL}/api/v1/berita/?limit=12`).then((r) =>
        r.ok ? r.json() : { data: [] },
    ),
    fetch(`${BACKEND_URL}/api/v1/regulasi/?limit=100`).then((r) =>
        r.ok ? r.json() : { data: [] },
    ),
    fetch(`${BACKEND_URL}/api/v1/pengumuman?limit=10`).then((r) =>
        r.ok ? r.json() : { data: [] },
    ),
]);

const berita = (
    (beritaRaw.status === "fulfilled" ? beritaRaw.value?.data : null) ?? []
).map((b: any) => ({
    ...b,
    thumbnail: toUploadProxyUrl(b.thumbnail) || b.thumbnail,
}));

const regulasiAll = (
    (regulasiRaw.status === "fulfilled" ? regulasiRaw.value?.data : null) ?? []
).map((r: any) => ({
    ...r,
    fileUrl: toUploadProxyUrl(r.fileUrl) || r.fileUrl,
}));

const pengumuman = ((pengumumanRaw.status === "fulfilled"
    ? pengumumanRaw.value?.data
    : null) ?? []) as Array<{ id: number; judul: string; link: string | null }>;

// Sort by legal hierarchy then take 6
const regulasi = [...regulasiAll]
    .sort((a: any, b: any) => {
        const ai = TYPE_ORDER.indexOf((a.type ?? "").toUpperCase());
        const bi = TYPE_ORDER.indexOf((b.type ?? "").toUpperCase());
        if (ai === -1 && bi === -1) return 0;
        if (ai === -1) return 1;
        if (bi === -1) return -1;
        return ai - bi;
    })
    .slice(0, 6);

function formatDate(dateStr: string | null) {
    if (!dateStr) return "";
    return new Date(dateStr).toLocaleDateString("id-ID", {
        day: "numeric",
        month: "long",
        year: "numeric",
    });
}

function regulasiBadge(type: string) {
    const t = type.toUpperCase();
    switch (t) {
        case "PMA":
        case "PERMEN":
            return "bg-green/20 text-green";
        case "KMA":
            return "bg-yellow/20 text-yellow";
        case "PP":
        case "PERPRES":
        case "INPRES":
            return "bg-white/15 text-white/70";
        case "UU":
        case "PERPU":
            return "bg-white/20 text-white";
        default:
            return "bg-white/10 text-white/50";
    }
}

const structuredData = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Berita Resmi Kemenag Kota Probolinggo",
    description:
        "Berita resmi, pengumuman, dan liputan kegiatan Kantor Kementerian Agama Kota Probolinggo beserta regulasi dan informasi publik.",
    url: `${Astro.url.origin}/portal`,
    isPartOf: {
        "@type": "WebSite",
        name: "Kemenag Kota Probolinggo",
        url: Astro.url.origin,
    },
};
---

<style>
    /* ── Ticker berita terkini ───────────────────────────── */
    .ticker-track {
        display: flex;
        width: max-content;
        animation: ticker-scroll 40s linear infinite;
    }
    .ticker:hover .ticker-track {
        animation-play-state: paused;
    }
    /* Pita pengumuman: lebih pelan dari ticker berita */
    .pengumuman-track {
        animation-duration: 55s;
    }
    @keyframes ticker-scroll {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(-50%);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .ticker-track {
            animation: none;
        }
    }

    /* ── Scroll reveal ───────────────────────────────────── */
    [data-reveal] {
        opacity: 0;
        transition:
            opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
            transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform, opacity;
    }
    [data-reveal="up"] {
        transform: translateY(32px);
    }
    [data-reveal="left"] {
        transform: translateX(-32px);
    }
    [data-reveal].revealed {
        opacity: 1;
        transform: none;
    }
    [data-delay="1"] {
        transition-delay: 0.08s;
    }
    [data-delay="2"] {
        transition-delay: 0.16s;
    }
    [data-delay="3"] {
        transition-delay: 0.24s;
    }
    [data-delay="4"] {
        transition-delay: 0.32s;
    }
    [data-delay="5"] {
        transition-delay: 0.4s;
    }
    [data-delay="6"] {
        transition-delay: 0.48s;
    }

    /* ── News card hover ─────────────────────────────────── */
    .news-card {
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease;
    }
    .news-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
    }
</style>

<BaseLayout
    title="Berita Resmi"
    description="Berita resmi, pengumuman, dan liputan kegiatan Kantor Kementerian Agama Kota Probolinggo beserta regulasi dan informasi publik."
    ogTitle="Berita Resmi Kemenag Kota Probolinggo"
    ogDescription="Ikuti berita terkini, pengumuman, dan liputan kegiatan resmi Kemenag Kota Probolinggo."
    structuredData={structuredData}
>
    <!-- ══ TICKER TERKINI ══════════════════════════════════ -->
    {berita.length > 0 && (
        <div class="ticker -mx-4 sm:-mx-8 md:-mx-14 lg:-mx-20 bg-ink text-cream flex items-stretch overflow-hidden">
            <span class="shrink-0 z-10 bg-green text-white text-[10px] font-black uppercase tracking-[0.2em] px-3 sm:px-4 flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                Terkini
            </span>
            <div class="relative overflow-hidden flex-1">
                <div class="ticker-track">
                    {[0, 1].map((dup) => (
                        <div
                            class="flex shrink-0 items-center"
                            aria-hidden={dup === 1}
                        >
                            {berita.slice(0, 5).map((b: any) => (
                                <a
                                    href={`/portal/berita/${b.slug}`}
                                    class="flex items-center gap-2 px-5 py-2.5 text-xs text-cream/65 hover:text-white whitespace-nowrap transition-colors"
                                >
                                    <span class="w-1 h-1 bg-yellow shrink-0"></span>
                                    {b.judul}
                                </a>
                            ))}
                        </div>
                    ))}
                </div>
            </div>
        </div>
    )}

    <!-- ══ MARQUEE PENGUMUMAN ══════════════════════════════ -->
    {pengumuman.length > 0 && (
        <div class="ticker pengumuman-marquee -mx-4 sm:-mx-8 md:-mx-14 lg:-mx-20 bg-yellow/15 border-b border-ink/10 flex items-stretch overflow-hidden">
            <span class="shrink-0 z-10 bg-yellow text-ink text-[10px] font-black uppercase tracking-[0.2em] px-3 sm:px-4 flex items-center gap-2">
                <Icon name="mdi:bullhorn" class="w-3 h-3" />
                Pengumuman
            </span>
            <div class="relative overflow-hidden flex-1">
                <div class="ticker-track pengumuman-track">
                    {[0, 1].map((dup) => (
                        <div
                            class="flex shrink-0 items-center"
                            aria-hidden={dup === 1}
                        >
                            {pengumuman.map((p) =>
                                p.link ? (
                                    <a
                                        href={p.link}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="flex items-center gap-2 px-5 py-2.5 text-xs text-ink/70 hover:text-ink whitespace-nowrap transition-colors"
                                    >
                                        <span class="w-1 h-1 bg-green shrink-0"></span>
                                        {p.judul}
                                        <Icon
                                            name="mdi:arrow-top-right"
                                            class="w-3 h-3 opacity-40"
                                        />
                                    </a>
                                ) : (
                                    <span class="flex items-center gap-2 px-5 py-2.5 text-xs text-ink/70 whitespace-nowrap">
                                        <span class="w-1 h-1 bg-green shrink-0"></span>
                                        {p.judul}
                                    </span>
                                ),
                            )}
                        </div>
                    ))}
                </div>
            </div>
        </div>
    )}

    <!-- ══ LEAD PACKAGE ════════════════════════════════════ -->
    <section class="pt-8 md:pt-12 pb-12 md:pb-16">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-10">
            <!-- Berita utama -->
            {berita[0] && (
                <a
                    href={`/portal/berita/${berita[0].slug}`}
                    data-reveal="up"
                    class="news-card lg:col-span-3 group flex flex-col bg-cream border border-ink/10 overflow-hidden cursor-pointer"
                >
                    <div class="relative overflow-hidden h-64 sm:h-80 lg:h-[420px] shrink-0 bg-ink/5">
                        {berita[0].thumbnail ? (
                            <img
                                src={berita[0].thumbnail}
                                alt={berita[0].judul}
                                class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-500 ease-out"
                                loading="eager"
                                fetchpriority="high"
                            />
                        ) : (
                            <div class="w-full h-full flex items-center justify-center">
                                <svg
                                    viewBox="0 0 24 24"
                                    width="32"
                                    height="32"
                                    fill="currentColor"
                                    class="text-ink/10"
                                >
                                    <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" />
                                </svg>
                            </div>
                        )}
                        <span
                            class={`absolute top-3 left-3 text-[10px] font-black uppercase tracking-wider px-2 py-1 ${categoryColor(berita[0].kategori)}`}
                        >
                            {berita[0].kategori}
                        </span>
                    </div>

                    <div class="p-6 md:p-8 flex flex-col flex-1">
                        <span class="text-[11px] text-ink/35 font-medium mb-2 block">
                            {formatDate(
                                berita[0].publishedAt ?? berita[0].createdAt,
                            )}
                        </span>

                        <h1 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-ink leading-tight group-hover:text-green transition-colors">
                            {berita[0].judul}
                        </h1>

                        <p class="text-sm text-ink/50 leading-relaxed line-clamp-3 mt-3">
                            {berita[0].ringkasan}
                        </p>

                        <div class="flex items-center gap-1.5 mt-auto pt-5 text-[11px] font-bold uppercase tracking-wider text-green/60 group-hover:text-green transition-colors">
                            Baca Selengkapnya
                            <svg
                                viewBox="0 0 24 24"
                                width="12"
                                height="12"
                                fill="currentColor"
                                class="group-hover:translate-x-1 transition-transform"
                            >
                                <path d="M6.4 18L5 16.6 14.6 7H6V5h12v12h-2V8.4z" />
                            </svg>
                        </div>
                    </div>
                </a>
            )}

            <!-- Headline lainnya -->
            <div
                class="lg:col-span-2 flex flex-col border border-ink/10 bg-cream divide-y divide-ink/10"
                data-reveal="up"
                data-delay="1"
            >
                <div class="px-5 py-3 border-b border-ink/10 flex items-center gap-3">
                    <div class="w-1 h-4 bg-green shrink-0"></div>
                    <span class="text-[11px] font-black uppercase tracking-[0.18em] text-ink/60">
                        Headline Lainnya
                    </span>
                </div>

                {berita.slice(1, 4).map((b: any) => (
                    <a
                        href={`/portal/berita/${b.slug}`}
                        class="group flex gap-4 p-5 flex-1 items-start hover:bg-ink/3 transition-colors"
                    >
                        <div class="relative w-24 h-24 shrink-0 overflow-hidden bg-ink/5">
                            {b.thumbnail ? (
                                <img
                                    src={b.thumbnail}
                                    alt={b.judul}
                                    class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-500 ease-out"
                                    loading="lazy"
                                />
                            ) : (
                                <div class="w-full h-full flex items-center justify-center">
                                    <svg
                                        viewBox="0 0 24 24"
                                        width="24"
                                        height="24"
                                        fill="currentColor"
                                        class="text-ink/10"
                                    >
                                        <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" />
                                    </svg>
                                </div>
                            )}
                        </div>

                        <div class="flex flex-col min-w-0 flex-1 self-stretch">
                            <span
                                class={`self-start text-[9px] font-black uppercase tracking-wider px-1.5 py-0.5 mb-1.5 ${categoryColor(b.kategori)}`}
                            >
                                {b.kategori}
                            </span>

                            <h3 class="text-sm font-bold text-ink leading-snug group-hover:text-green transition-colors line-clamp-3">
                                {b.judul}
                            </h3>

                            <p class="text-xs text-ink/50 leading-relaxed line-clamp-2 mt-1.5">
                                {b.ringkasan}
                            </p>

                            <span class="text-[11px] text-ink/35 mt-auto pt-2">
                                {formatDate(b.publishedAt ?? b.createdAt)}
                            </span>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    </section>

    <!-- ══ BERITA TERBARU (GRID) ═══════════════════════════ -->
    <section class="pb-14 md:pb-20">
        <div data-reveal="up" class="mb-8 flex items-end justify-between gap-4">
            <div>
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-1 h-6 bg-green"></div>
                    <span class="text-[11px] font-black uppercase tracking-[0.18em] text-green">
                        Terbaru & Pengumuman
                    </span>
                </div>
                <h2 class="text-3xl sm:text-4xl font-extrabold uppercase tracking-tight text-ink">
                    Berita Terbaru
                </h2>
            </div>

            <a
                href="/portal/berita"
                class="hidden sm:inline-flex shrink-0 items-center gap-2 border border-ink/20 bg-cream px-5 py-2.5 text-xs font-bold uppercase tracking-wide hover:border-green hover:text-green transition-colors"
            >
                Lihat Semua
                <svg
                    viewBox="0 0 24 24"
                    width="13"
                    height="13"
                    fill="currentColor"
                >
                    <path d="M6.4 18L5 16.6 14.6 7H6V5h12v12h-2V8.4z" />
                </svg>
            </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
            {berita.length === 0 ? (
                <p class="col-span-full text-center py-16 text-sm text-ink/30 font-medium uppercase tracking-wider">
                    Belum ada berita
                </p>
            ) : (
                berita.slice(4).map((b: any, i: number) => (
                    <a
                        href={`/portal/berita/${b.slug}`}
                        data-reveal="up"
                        data-delay={String((i % 4) + 1)}
                        class="news-card bg-cream border border-ink/10 flex flex-col cursor-pointer group overflow-hidden"
                    >
                        <!-- Thumbnail -->
                        <div class="relative overflow-hidden h-44 shrink-0 bg-ink/5">
                            {b.thumbnail ? (
                                <img
                                    src={b.thumbnail}
                                    alt={b.judul}
                                    class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-500 ease-out"
                                    loading="lazy"
                                />
                            ) : (
                                <div class="w-full h-full flex items-center justify-center">
                                    <svg
                                        viewBox="0 0 24 24"
                                        width="32"
                                        height="32"
                                        fill="currentColor"
                                        class="text-ink/10"
                                    >
                                        <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" />
                                    </svg>
                                </div>
                            )}
                            <span
                                class={`absolute top-3 left-3 text-[10px] font-black uppercase tracking-wider px-2 py-1 ${categoryColor(b.kategori)}`}
                            >
                                {b.kategori}
                            </span>
                        </div>

                        <!-- Color accent bar -->
                        <div
                            class={`h-0.5 w-full shrink-0 ${categoryAccent(b.kategori)}`}
                        />

                        <div class="p-5 md:p-6 flex flex-col flex-1">
                            <span class="text-[11px] text-ink/35 font-medium mb-3 block">
                                {formatDate(b.publishedAt ?? b.createdAt)}
                            </span>

                            <h3 class="text-sm sm:text-base font-bold text-ink leading-snug mb-2 group-hover:text-green transition-colors flex-1">
                                {b.judul}
                            </h3>

                            <p class="text-xs sm:text-[13px] text-ink/50 leading-relaxed line-clamp-3">
                                {b.ringkasan}
                            </p>

                            <div class="flex items-center gap-1.5 mt-4 text-[11px] font-bold uppercase tracking-wider text-green/60 group-hover:text-green transition-colors">
                                Selengkapnya
                                <svg
                                    viewBox="0 0 24 24"
                                    width="12"
                                    height="12"
                                    fill="currentColor"
                                    class="group-hover:translate-x-1 transition-transform"
                                >
                                    <path d="M6.4 18L5 16.6 14.6 7H6V5h12v12h-2V8.4z" />
                                </svg>
                            </div>
                        </div>
                    </a>
                ))
            )}
        </div>

        <div data-reveal="up" class="mt-8 text-center sm:hidden">
            <a
                href="/portal/berita"
                class="inline-flex items-center gap-2 border border-ink/20 bg-cream px-6 py-3 text-sm font-bold uppercase tracking-wide hover:border-green hover:text-green transition-colors"
            >
                Lihat Semua Berita
                <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="currentColor"
                >
                    <path d="M6.4 18L5 16.6 14.6 7H6V5h12v12h-2V8.4z" />
                </svg>
            </a>
        </div>
    </section>

    <!-- ══ TOLAK GRATIFIKASI ═══════════════════════════════ -->
    <section
        class="-mx-4 sm:-mx-8 md:-mx-14 lg:-mx-20 px-4 sm:px-8 md:px-14 lg:px-20 py-14 md:py-20 relative overflow-hidden"
        style="background:#F6C744;"
    >
        <!-- Diagonal stripe pattern -->
        <div
            class="absolute inset-0 pointer-events-none"
            style="background: repeating-linear-gradient(45deg, transparent, transparent 20px, rgba(0,0,0,0.03) 20px, rgba(0,0,0,0.03) 40px);"
        ></div>
        <!-- Giant watermark "0" -->
        <div
            class="absolute inset-0 flex items-center justify-center pointer-events-none select-none overflow-hidden"
            style="opacity:0.05;"
        >
            <span style="font-size:22rem; font-weight:900; line-height:1; color:#111;">
                0
            </span>
        </div>

        <div class="relative z-10 max-w-3xl mx-auto text-center">
            <div data-reveal="up" class="inline-flex mb-6">
                <div class="w-16 h-16 bg-ink/10 border-2 border-ink/20 flex items-center justify-center">
                    <svg
                        viewBox="0 0 24 24"
                        width="32"
                        height="32"
                        fill="currentColor"
                        class="text-ink"
                    >
                        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z" />
                    </svg>
                </div>
            </div>

            <h2
                data-reveal="up"
                data-delay="1"
                class="text-3xl sm:text-4xl md:text-5xl font-extrabold uppercase tracking-tight text-ink mb-4 leading-tight"
            >
                Tolak Gratifikasi.
                <br />
                Lawan Korupsi.
            </h2>

            <p
                data-reveal="up"
                data-delay="2"
                class="text-sm sm:text-base text-ink/60 max-w-xl mx-auto leading-relaxed mb-8"
            >
                Kantor Kementerian Agama Kota Probolinggo berkomitmen
                <strong class="text-ink">nol toleransi</strong> terhadap segala
                bentuk gratifikasi, pungutan liar, dan korupsi. Jika Anda
                menemukan pelanggaran, segera laporkan.
            </p>

            <!-- What to report -->
            <div
                data-reveal="up"
                data-delay="3"
                class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-10 text-left"
            >
                {[
                    { icon: "💸", label: "Pungutan Liar (Pungli)" },
                    { icon: "🤝", label: "Permintaan Gratifikasi" },
                    { icon: "⚖️", label: "Penyalahgunaan Jabatan" },
                ].map((p) => (
                    <div class="flex items-center gap-3 bg-ink/8 border border-ink/15 px-4 py-3">
                        <span class="text-xl shrink-0">{p.icon}</span>
                        <span class="text-xs font-bold text-ink uppercase tracking-wide">
                            {p.label}
                        </span>
                    </div>
                ))}
            </div>

            <!-- CTA buttons -->
            <div
                data-reveal="up"
                data-delay="4"
                class="flex flex-col sm:flex-row gap-3 justify-center"
            >
                <a
                    href="/pengaduan"
                    class="inline-flex items-center justify-center gap-2 bg-ink text-cream font-bold text-sm uppercase tracking-wider px-8 py-4 hover:bg-ink/90 active:scale-[0.98] transition-all"
                >
                    <svg
                        viewBox="0 0 24 24"
                        width="16"
                        height="16"
                        fill="currentColor"
                    >
                        <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z" />
                    </svg>
                    Laporkan Sekarang
                </a>
                <a
                    href="https://gol.kpk.go.id"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 bg-ink/10 border-2 border-ink/30 text-ink font-bold text-sm uppercase tracking-wider px-8 py-4 hover:bg-ink/20 active:scale-[0.98] transition-all"
                >
                    <svg
                        viewBox="0 0 24 24"
                        width="14"
                        height="14"
                        fill="currentColor"
                    >
